# Используется сейчас. Публичные значения доступны клиентскому коду.
NEXT_PUBLIC_APP_NAME=UstaBIM Tools
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Используется для Supabase SDK и проверки соединения.
# Укажите Project URL и публичный anon/publishable key из Connect dialog.
# Оба значения могут быть доступны браузеру и не заменяют RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Будет использоваться позднее. Только сервер: не передавать в браузер.
SUPABASE_SERVICE_ROLE_KEY=

# HTTPS URL отдельного n8n workflow для веб-чата. Никогда не добавляйте в NEXT_PUBLIC_.
N8N_CHAT_WEBHOOK_URL=
# Общий секрет (не менее 32 символов) для HMAC-подписи запросов web -> n8n.
N8N_INTERNAL_SECRET=
# HTTPS webhook URLs из изолированных UstaBIM Geology MVP workflow.
N8N_GEOLOGY_UPLOAD_WEBHOOK_URL=
N8N_GEOLOGY_STATUS_WEBHOOK_URL=
N8N_GEOLOGY_DOWNLOAD_WEBHOOK_URL=

# OPENAI_API_KEY должен храниться только в окружении n8n.
OPENAI_API_KEY=

DOCUMENT_WORKER_URL=
DOCUMENT_WORKER_SECRET=

IFC_WORKER_URL=
IFC_WORKER_SECRET=

REDIS_URL=
DATABASE_URL=
