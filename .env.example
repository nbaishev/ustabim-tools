# Public variables: these two values may be exposed to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets and internal addresses. Never expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=

N8N_CHAT_WEBHOOK_URL=
N8N_GEOLOGY_WEBHOOK_URL=
N8N_INTERNAL_SECRET=

# OPENAI_API_KEY belongs only in n8n runtime configuration.
OPENAI_API_KEY=

DOCUMENT_WORKER_URL=
DOCUMENT_WORKER_SECRET=

IFC_WORKER_URL=
IFC_WORKER_SECRET=

REDIS_URL=
DATABASE_URL=
