# Используется сейчас. Публичные значения доступны клиентскому коду.
NEXT_PUBLIC_APP_NAME=UstaBIM Tools
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Используется для Supabase SDK и проверки соединения.
# Укажите Project URL и публичный anon/publishable key из Connect dialog.
# Оба значения могут быть доступны браузеру и не заменяют RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Будет использоваться позднее. Только сервер: не передавать в браузер.
SUPABASE_SERVICE_ROLE_KEY=

N8N_CHAT_WEBHOOK_URL=
N8N_GEOLOGY_WEBHOOK_URL=
N8N_INTERNAL_SECRET=

# OPENAI_API_KEY должен храниться только в окружении n8n.
OPENAI_API_KEY=

DOCUMENT_WORKER_URL=
DOCUMENT_WORKER_SECRET=

IFC_WORKER_URL=
IFC_WORKER_SECRET=

REDIS_URL=
DATABASE_URL=
